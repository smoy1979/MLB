{
    "version": "0.2.0",
    "configurations": [     
        {
            "name": "mlb_scheduler.py",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "env": {
                "PYDEVD_WARN_EVALUATION_TIMEOUT": "300000",
                "PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "3",
                "PYTHONPATH": "${workspaceFolder}",
            }
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYDEVD_WARN_EVALUATION_TIMEOUT": "300000",
                "PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "3",
                "PYTHONPATH": "${workspaceFolder}",
            },
            "args": [
                "--evaluate-year=2026"
            ]
        }
    ]
}